# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=this_studio
DB_USER=postgres
DB_PASS=changeme
DB_URL=jdbc:postgresql://postgres:5432/this_studio
POSTGRES_PORT=5432

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PORT=8000

# ── Inference (Python FastAPI + LoRA model) ───────────────────────────────────
INFERENCE_PORT=8001
MODEL_PATH=outputs/socratic-tutor-lora
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=default
# JPA_DDL_AUTO=validate  # use 'create' only on first run to create schema

# ── Firecrawl (self-hosted) ───────────────────────────────────────────────────
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=changeme

# ── Ollama (synthetic data generation) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Training (optional – Weights & Biases) ────────────────────────────────────
# REPORT_TO=wandb
# WANDB_API_KEY=changeme
# WANDB_PROJECT=socratic-tutor

# ── HuggingFace Hub (optional – push model) ───────────────────────────────────
# HF_TOKEN=changeme
