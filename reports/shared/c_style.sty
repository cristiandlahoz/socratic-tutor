\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{c_style}[2025/03/02 C code syntax highlighting]

% Dependencies
\RequirePackage{listings}
\RequirePackage{xcolor}

% --- Color palette ---
\definecolor{c@keyColour}{RGB}{163,21,21}          % keywords — dark red
\definecolor{c@directiveColour}{RGB}{0,0,160}      % #include / #define — dark blue
\definecolor{c@typeColour}{RGB}{0,100,180}          % int, float, char… — medium blue
\definecolor{c@stringColour}{RGB}{130,0,130}        % string/char literals — purple
\definecolor{c@commentColour}{RGB}{0,128,0}         % comments — green
\definecolor{c@lineNumberColour}{RGB}{130,130,130}  % line numbers — grey
\definecolor{c@bgColour}{RGB}{254,254,252}          % background — warm white
\definecolor{c@ruleColour}{RGB}{150,150,150}        % frame rule — grey
\definecolor{c@funcColour}{RGB}{180,90,0}           % function names — burnt orange
\definecolor{c@macroColour}{RGB}{0,110,110}         % macros NULL, EOF — teal

% --- C style ---
\lstdefinestyle{c_style}{
  language=C,
  backgroundcolor=\color{c@bgColour},
  basicstyle=\ttfamily\footnotesize\color{black},
  commentstyle=\color{c@commentColour}\itshape,
  keywordstyle=\color{c@keyColour}\bfseries,
  stringstyle=\color{c@stringColour},
  numberstyle=\footnotesize\color{c@lineNumberColour},
  % Standard C types
  emph={[1]int,float,double,char,void,long,short,unsigned,signed,
        size_t,ptrdiff_t,bool,_Bool,FILE,NULL,EOF,
        uint8_t,uint16_t,uint32_t,uint64_t,
        int8_t,int16_t,int32_t,int64_t},
  emphstyle={[1]\color{c@typeColour}},
  % Preprocessor keywords
  emph={[2]include,define,ifdef,ifndef,endif,pragma,undef,error,warning},
  emphstyle={[2]\color{c@directiveColour}\bfseries},
  % Common stdlib/stdio functions
  emph={[3]printf,scanf,fprintf,fscanf,sprintf,sscanf,
        malloc,calloc,realloc,free,
        strlen,strcpy,strncpy,strcmp,strncmp,strcat,strncat,strchr,strstr,
        fopen,fclose,fread,fwrite,fgets,fputs,
        exit,abort,assert},
  emphstyle={[3]\color{c@funcColour}},
  % Macros / constants
  emph={[4]NULL,EOF,TRUE,FALSE,STDIN,STDOUT,STDERR},
  emphstyle={[4]\color{c@macroColour}\bfseries},
  numbers=left,
  numbersep=6pt,
  xleftmargin=16pt,
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  keepspaces=true,
  tabsize=4,
  captionpos=b,
  frame=trbl,
  frameround=tttt,
  framesep=.3ex,
  rulecolor=\color{c@ruleColour},
  lineskip=1pt,
}

% Environment
\lstnewenvironment{ccode}
  {\lstset{style=c_style}}
  {}

% Inline command
\newcommand*{\cinline}{\lstinline[style=c_style,basicstyle=\ttfamily\small]}

\endinput
