\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{json_style}[2025/03/02 JSON syntax highlighting]

% Dependencies
\RequirePackage{listings}
\RequirePackage{xcolor}

% --- Color palette (blue / green / grey) ---
\definecolor{json@keyColour}{RGB}{0,80,160}        % property keys  — dark blue
\definecolor{json@stringColour}{RGB}{0,128,96}     % string values  — teal-green
\definecolor{json@numberColour}{RGB}{180,80,0}     % numeric values — burnt orange
\definecolor{json@boolColour}{RGB}{130,0,130}      % true/false/null — purple
\definecolor{json@punctColour}{RGB}{90,90,90}      % braces/brackets — grey
\definecolor{json@commentColour}{RGB}{120,120,120} % // comments     — light grey
\definecolor{json@bgColour}{RGB}{252,253,255}      % background      — near-white

% --- Declare JSON as a listings language ---
\lstdefinelanguage{json}{
  morestring=[b]",
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  sensitive=true,
}

% --- JSON style ---
\lstdefinestyle{json_style}{
  language=json,
  backgroundcolor=\color{json@bgColour},
  basicstyle=\ttfamily\footnotesize\color{black},
  stringstyle=\color{json@stringColour},
  commentstyle=\color{json@commentColour}\itshape,
  emph={[1]true,false,null},
  emphstyle={[1]\color{json@boolColour}\bfseries},
  numberstyle=\footnotesize\color{json@punctColour},
  numbers=left,
  numbersep=6pt,
  xleftmargin=16pt,
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  keepspaces=true,
  tabsize=2,
  captionpos=b,
  frame=trbl,
  frameround=tttt,
  framesep=.3ex,
  rulecolor=\color{json@punctColour},
  lineskip=1pt,
}

% Environment
\lstnewenvironment{jsoncode}
  {\lstset{style=json_style}}
  {}

% Inline command
\newcommand*{\jsoninline}{\lstinline[style=json_style,basicstyle=\ttfamily\small]}

\endinput
