# RunPod persistent-storage defaults for the Socratic Tutor inference engine.
#
# RunPod keeps /workspace across pods. Source this file before running the
# inference-engine scripts, or use bootstrap-inference_engine-runpod.sh.
#
# Note: RunPod's persistent directory is /workspace (not /worksapce).

RUNPOD_WORKSPACE="${RUNPOD_WORKSPACE:-/workspace}"
RUNPOD_INFERENCE_ENGINE_DIR="${RUNPOD_INFERENCE_ENGINE_DIR:-$RUNPOD_WORKSPACE/inference-engine}"

export BIN_DIR="${BIN_DIR:-$RUNPOD_WORKSPACE/bin}"
export LLAMA_CPP_DIR="${LLAMA_CPP_DIR:-$RUNPOD_WORKSPACE/llama.cpp}"
export LLAMA_CACHE="${LLAMA_CACHE:-$RUNPOD_WORKSPACE/llama-cache}"
export LLAMA_SWAP_BIN="${LLAMA_SWAP_BIN:-$BIN_DIR/llama-swap}"
export LLAMA_SERVER_BIN="${LLAMA_SERVER_BIN:-$BIN_DIR/llama-server}"

export LOG_FILE="${LOG_FILE:-$RUNPOD_INFERENCE_ENGINE_DIR/inference-engine.log}"
export PID_FILE="${PID_FILE:-$RUNPOD_INFERENCE_ENGINE_DIR/inference-engine.pid}"
export MONITOR_LOG_FILE="${MONITOR_LOG_FILE:-$RUNPOD_INFERENCE_ENGINE_DIR/inference-engine-monitor.log}"
export MONITOR_PID_FILE="${MONITOR_PID_FILE:-$RUNPOD_INFERENCE_ENGINE_DIR/inference-engine-monitor.pid}"
export STATE_DIR="${STATE_DIR:-$RUNPOD_INFERENCE_ENGINE_DIR/monitor-state}"

# Keep common model/cache tooling on the persistent volume too. llama-server uses
# LLAMA_CACHE above for GGUF downloads, but these prevent future helper tooling
# from silently filling an ephemeral home directory.
export HF_HOME="${HF_HOME:-$RUNPOD_WORKSPACE/huggingface}"
export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HOME/hub}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$RUNPOD_WORKSPACE/.cache}"

export PATH="$BIN_DIR:$PATH"
